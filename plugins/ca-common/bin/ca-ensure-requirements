#!/usr/bin/env bash

# Runs the equivalent of `devbox services up`, waits for every process to
# be ready or completed, and logs errors on failure. With --process=NAME it
# instead ensures only the named process (or meta-process) and its full
# dependency graph.
#
# In both modes the process set is resolved through process-compose itself
# (devbox merges plugin-contributed process-compose files at boot). On a
# cold start the default mode boots PC with no target, so it covers exactly
# what a bare `devbox services up` starts — every process not marked
# `disabled: true`. On a warm start it ensures every process the running
# instance has *enabled*: PC reports processes excluded by a targeted boot
# (`devbox services up <name>`) as Disabled, indistinguishable from config
# `disabled: true`, so a target-scoped instance keeps its scope.
#
# Autodetects lifecycle from the runtime state after the graph is
# satisfied:
#   - Any node still is_running == true → daemon-mode: PC is left running.
#   - Every node has already Completed  → command-mode: PC is reaped.
#
# "Satisfied" is per-node, driven by the strongest depends_on condition
# the node's in-graph dependents declare on it (see node_satisfied in
# _lib.bash):
#   - process_completed_successfully: Completed AND exit_code == 0
#   - process_completed:              Completed with ANY exit code — the
#                                     condition explicitly tolerates failure,
#                                     so a non-zero exit neither blocks nor
#                                     fails the run for such a node
#   - process_healthy:                readiness_probe Ready
#   - process_started:                is_running == true
#   - the target itself (no dependents): Ready, or Completed w/ exit 0
# A merely-running probe-less process never satisfies a "completed" or
# target requirement: a slow one-shot mid-run is indistinguishable from a
# probe-less daemon, and accepting it would report success before the
# one-shot's exit code exists. Long-running processes therefore need a
# readiness_probe (or a dependent that only declares process_started).
# Failure detection is terminal-state only (Completed with non-zero exit,
# or Error): a Running process may still carry the previous run's non-zero
# exit_code after a policy restart and must not abort the run.
# Success waits for every node in the dependency graph.
#
# Cold start uses `devbox services up --background --pcflags=--keep-project`
# so the API stays reachable even if the graph turns out to be pure
# one-shots (which would otherwise drain PC's process list before we can
# poll). Warm start uses the API and doesn't touch PC lifecycle.
#
# Design notes:
#   - No graph-shape rejection. A one-shot target that transitively depends
#     on a daemon is legal and results in daemon-mode (PC left up so the
#     daemon stays reachable to subsequent commands).
#   - The daemon-vs-oneshot lifecycle decision is made from runtime state
#     (is_running after the graph is satisfied), not from the static
#     `isDaemon` config or the presence of a readiness_probe. A one-shot
#     that happens to carry a readiness_probe is treated as a one-shot for
#     PC-lifecycle purposes.

readonly DEFAULT_TIMEOUT=600

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
# shellcheck source=_lib.bash disable=SC1091
source "$SCRIPT_DIR/_lib.bash"

usage() {
  cat <<EOF
Usage: $(basename "$0") [--process=NAME] [--timeout=SECONDS] [--process-compose-file=PATH] [--help]

Runs the equivalent of \`devbox services up\`, waits for every process to be
ready or completed, and logs errors on failure. Daemons must become Ready
(via readiness_probe), one-shots must Complete with exit 0 — a long-running
process without a readiness_probe cannot be verified and times out.
process-compose is left running iff the graph contains a long-running daemon.

Options:
  --process=NAME              Ensure only the named process (or meta-process)
                              and its dependency graph, instead of every process
  --timeout=SECONDS           Timeout for the dependency graph (default: $DEFAULT_TIMEOUT)
  --process-compose-file=PATH Path to process-compose file
                              (default: \$DEVBOX_PROJECT_ROOT/process-compose.yaml, falling back to .yml)
  --help                      Show this help message
EOF
}

main() {
  local timeout_seconds=$DEFAULT_TIMEOUT
  local pcfile=""
  local target=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --process=*)
        target="${1#*=}"
        if [ -z "$target" ]; then
          echo "Error: --process requires a non-empty process name." >&2
          exit 1
        fi
        shift ;;
      --timeout=*)
        local value="${1#*=}"
        if ! [[ "$value" =~ ^[0-9]+$ ]] || [ "$value" -le 0 ]; then
          echo "Invalid --timeout value '$value'. It must be a positive integer." >&2
          exit 1
        fi
        timeout_seconds="$value"
        shift ;;
      --process-compose-file=*)
        pcfile="${1#*=}"
        shift ;;
      --help|-h)
        usage
        exit 0 ;;
      *)
        break ;;
    esac
  done

  echo ""

  if [[ -z "$DEVBOX_PROJECT_ROOT" ]]; then
    echo "Error: This script must be run inside a devbox shell." >&2
    exit 1
  fi

  if [ -z "$pcfile" ]; then
    pcfile="$DEVBOX_PROJECT_ROOT/process-compose.yaml"
    if [ ! -f "$pcfile" ] && [ -f "$DEVBOX_PROJECT_ROOT/process-compose.yml" ]; then
      pcfile="$DEVBOX_PROJECT_ROOT/process-compose.yml"
    fi
  fi

  if [ "$#" -ne 0 ]; then
    echo "Error: positional process names are no longer accepted. Use --process=$1 instead." >&2
    usage >&2
    exit 1
  fi

  PCPORT=$(pcport_if_running)
  if [ -z "$PCPORT" ]; then
    # Arm the reaper BEFORE booting so any early failure inside cold_start
    # (partial devbox up, wait_for_port timeout, expand/classify errors,
    # graph failure) triggers cleanup. The happy path disarms iff the graph
    # has a daemon that should keep PC alive.
    arm_reaper "$pcfile"
    cold_start "$target" "$pcfile" "$timeout_seconds"
  else
    export PCPORT
    warm_start "$target" "$timeout_seconds"
  fi
}

cold_start() {
  local target="$1"
  local pcfile="$2"
  local timeout_seconds="$3"

  if [ ! -f "$pcfile" ]; then
    echo "Error: process-compose file not found at '$pcfile'." >&2
    echo "  Pass --process-compose-file=PATH or place process-compose.yaml (or .yml) at the project root." >&2
    exit 1
  fi

  echo "process-compose is not running — booting via \`devbox services up --background\`."
  # --keep-project keeps PC alive if the dependency graph turns out to be
  # pure one-shots (which would drain PC's process list). We always tear
  # PC down again after unless the graph has a real daemon. All-mode boots
  # with no target, so devbox starts everything — same as a bare
  # `devbox services up`.
  local up_args=(--pcflags=--keep-project --process-compose-file="$pcfile")
  [ -n "$target" ] && up_args+=("$target")
  devbox_services_up_background "${up_args[@]}" \
    || { echo "Failed to start process-compose." >&2; exit 1; }

  PCPORT=$(wait_for_port)
  if [ -z "$PCPORT" ]; then
    echo "Error: process-compose did not become reachable in ${API_WAIT_TIMEOUT_SECONDS}s." >&2
    exit 1
  fi
  export PCPORT
  echo "process-compose booted on port $PCPORT."
  echo ""

  run_target_or_all "$target" "$timeout_seconds"
}

warm_start() {
  local target="$1"
  local timeout_seconds="$2"
  echo "process-compose already running on port $PCPORT — using API."
  echo ""

  run_target_or_all "$target" "$timeout_seconds"
}

# Resolve the run's graph roots — the named process in --process mode, or
# every enabled process otherwise — and hand off to the shared flow. The
# all-mode root set comes from the process-compose API, which reports the
# full merged configuration (root file + plugin-contributed files).
# Disabled processes are excluded, as `devbox services up` doesn't run
# them; note PC also reports processes excluded by a targeted boot as
# Disabled (see the file-header docstring for the scope rule this
# implies). Requires $PCPORT.
run_target_or_all() {
  local target="$1"
  local timeout_seconds="$2"

  if [ -n "$target" ]; then
    run_dependency_graph "$timeout_seconds" "'$target' and dependencies" "$target"
    return
  fi

  local names
  names=$(list_enabled_process_names) \
    || { echo "Failed to enumerate processes from the process-compose API." >&2; exit 1; }
  local roots=() name
  while IFS= read -r name; do
    [ -n "$name" ] && roots+=("$name")
  done <<< "$names"
  if [ "${#roots[@]}" -eq 0 ]; then
    echo "Error: no enabled processes found in the process-compose configuration." >&2
    exit 1
  fi
  run_dependency_graph "$timeout_seconds" "All processes" "${roots[@]}"
}

# Echo "yes" if any dependency graph member is currently a running service
# (is_running == true), else "no". Operates on the /processes response
# snapshot passed in (typically the one the wait loop just used to decide
# the graph was satisfied) rather than fetching again — the two-fetch
# variant races when a probe-less daemon flaps is_running between wait
# success and classification, causing a healthy PC to be reaped.
# Using runtime state (over the static `isDaemon` config field) also
# correctly treats a one-shot that carries a readiness_probe as a one-shot
# for the PC-lifecycle decision.
graph_has_long_running_process() {
  local dependency_graph="$1"
  local processes_response="$2"
  local name
  while IFS= read -r name; do
    [ -z "$name" ] && continue
    local is_running
    is_running=$(echo "$processes_response" \
      | jq -r --arg n "$name" '.data[] | select(.name == $n) | .is_running')
    if [ "$is_running" = "true" ]; then
      echo "yes"
      return 0
    fi
  done <<< "$dependency_graph"
  echo "no"
}

# On failure paths (expand/classify errors, dep-graph failure, timeout) the
# EXIT trap set by main() reaps PC. On the happy path we classify the graph
# and either clear the trap (daemon-mode: leave PC up) or let it fire
# (command-mode: reap PC).
run_dependency_graph() {
  local timeout_seconds="$1"
  # Human-readable subject for the final status messages, e.g.
  # "'foo' and dependencies" or "All processes".
  local label="$2"
  shift 2
  # Remaining args: the graph roots.

  # expand emits "name<TAB>requirement" rows in dependency order; split
  # into the name list the helpers iterate and the per-node requirement map.
  local graph_tsv
  graph_tsv=$(expand_dependency_graph "$@") \
    || { echo "Failed to expand dependency graph." >&2; exit 1; }

  local dependency_graph
  dependency_graph=$(cut -f1 <<< "$graph_tsv")
  declare -A requirement_of=()
  local name req
  # SC2034 misfires: requirement_of is consumed via nameref (passed by
  # name below).
  # shellcheck disable=SC2034
  while IFS=$'\t' read -r name req; do
    [ -z "$name" ] && continue
    requirement_of[$name]="$req"
  done <<< "$graph_tsv"

  start_dependency_graph_services "$dependency_graph" requirement_of \
    || { echo "Failed to start dependency graph services." >&2; exit 1; }

  local wait_snapshot=""
  wait_for_dependency_graph_satisfied "$dependency_graph" "$timeout_seconds" wait_snapshot requirement_of
  local rc=$?

  if [ $rc -ne 0 ]; then
    handle_dependency_graph_failure "$dependency_graph" "$rc" \
      "Timeout: dependency graph did not become ready after ${timeout_seconds}s." \
      requirement_of
    exit 1
  fi

  local has_daemon
  has_daemon=$(graph_has_long_running_process "$dependency_graph" "$wait_snapshot")
  if [ "$has_daemon" = "yes" ]; then
    disarm_reaper
    echo "$label are ready. Leaving process-compose running."
  else
    echo "$label completed successfully."
  fi
}

wait_for_dependency_graph_satisfied() {
  local dependency_graph="$1"
  local timeout_seconds="$2"
  # Output param: nameref to the caller's variable that receives the
  # /processes response body from the iteration that decided the graph
  # was satisfied. Reused by the classifier so its lifecycle decision is
  # made from the same snapshot as the success decision.
  local -n _snapshot="$3"
  # Name of the caller's associative array holding each node's requirement
  # (from expand_dependency_graph).
  local -n _requirements="$4"
  _snapshot=""
  local start_time
  start_time=$(date +%s)
  local first_iter=1
  # Group markers are emitted lazily so a no-op warm start doesn't leave
  # an empty `::group::` ... `::endgroup::`.
  local printed_group=0
  trap '[ "$printed_group" = "1" ] && echo "::endgroup::"' RETURN

  while true; do
    local processes_response
    processes_response=$(curl -s "http://localhost:$PCPORT/processes")
    if [ -z "$processes_response" ] || ! echo "$processes_response" | jq -e . >/dev/null 2>&1; then
      echo "  process-compose API not responding."
      return 1
    fi

    declare -A state_map fail_map
    load_state_maps "$processes_response" state_map fail_map

    local pending_count=0 name
    while IFS= read -r name; do
      [ -z "$name" ] && continue
      local requirement="${_requirements[$name]:-default}"
      # A terminal failure aborts the run — unless the node's strongest
      # requirement is process_completed, which tolerates any exit code
      # (node_satisfied then accepts the completed_failed state).
      if [ "${fail_map[$name]:-ok}" = "fail" ] && [ "$requirement" != "completed_any" ]; then
        return 1
      fi
      # A name missing from the snapshot defaults to state "pending" — a
      # graph member the API doesn't report must never count as satisfied.
      node_satisfied "${state_map[$name]:-pending}" "$requirement" \
        || pending_count=$((pending_count + 1))
    done <<< "$dependency_graph"

    if [ "$pending_count" -eq 0 ]; then
      _snapshot="$processes_response"
      return 0
    fi

    if [ "$printed_group" = "0" ]; then
      echo "::group::Waiting for dependency graph to be ready"
      printed_group=1
    fi

    if [ "$first_iter" = "1" ]; then
      first_iter=0
    else
      echo ""
    fi
    print_processes_table "$processes_response"

    local elapsed=$(( $(date +%s) - start_time ))
    if (( elapsed >= timeout_seconds )); then
      return 2
    fi
    sleep 1
    unset state_map fail_map
  done
}

main "$@"
